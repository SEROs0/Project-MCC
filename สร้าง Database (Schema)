นำ SQL ด้านล่างไปรันใน MySQL:

```sql
CREATE DATABASE IF NOT EXISTS mcc_project
  CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE mcc_project;

-- ตารางแผนก
CREATE TABLE departments (
  id    INT AUTO_INCREMENT PRIMARY KEY,
  name  VARCHAR(100) NOT NULL
);

-- ตารางผู้ป่วย
CREATE TABLE patients (
  id             INT AUTO_INCREMENT PRIMARY KEY,
  hn             VARCHAR(20) UNIQUE NOT NULL,
  name           VARCHAR(100) NOT NULL,
  age            INT,
  sex            VARCHAR(10),
  blood_type     VARCHAR(5),
  allergy        VARCHAR(255) DEFAULT '-',
  congenital     VARCHAR(255) DEFAULT '-',
  status         VARCHAR(50)  DEFAULT 'ปกติ',
  weight         DECIMAL(5,2),
  height         DECIMAL(5,2),
  bmi            DECIMAL(5,2),
  blood_pressure VARCHAR(20),
  pulse          INT,
  temperature    DECIMAL(4,1),
  updated_at     DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  created_at     DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- ตารางแพทย์
CREATE TABLE doctors (
  id             INT AUTO_INCREMENT PRIMARY KEY,
  name           VARCHAR(100) NOT NULL,
  employee_id    VARCHAR(20)  UNIQUE NOT NULL,
  password       VARCHAR(255) NOT NULL,
  specialty      VARCHAR(100),
  department_id  INT,
  capacity       INT DEFAULT 5,
  created_at     DATETIME DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (department_id) REFERENCES departments(id)
);

-- ตารางช่วงเวลานัด
CREATE TABLE time_slots (
  id         INT AUTO_INCREMENT PRIMARY KEY,
  slot_time  TIME NOT NULL
);

-- ตารางการจองคิว
CREATE TABLE bookings (
  id             INT AUTO_INCREMENT PRIMARY KEY,
  patient_id     INT NOT NULL,
  doctor_id      INT NOT NULL,
  slot_time_id   INT NOT NULL,
  booking_date   DATE NOT NULL,
  queue_number   INT,
  symptom        TEXT,
  note           TEXT,
  status         ENUM('รอตรวจ','กำลังตรวจ','เสร็จสิ้น') DEFAULT 'รอตรวจ',
  created_at     DATETIME DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (patient_id)   REFERENCES patients(id),
  FOREIGN KEY (doctor_id)    REFERENCES doctors(id),
  FOREIGN KEY (slot_time_id) REFERENCES time_slots(id)
);

-- ตารางนับจำนวนการจองต่อ slot
CREATE TABLE slot_bookings (
  id            INT AUTO_INCREMENT PRIMARY KEY,
  doctor_id     INT NOT NULL,
  slot_time_id  INT NOT NULL,
  booking_date  DATE NOT NULL,
  booked_count  INT DEFAULT 0,
  FOREIGN KEY (doctor_id)    REFERENCES doctors(id),
  FOREIGN KEY (slot_time_id) REFERENCES time_slots(id)
);

-- ตารางประวัติการรักษา
CREATE TABLE medical_history (
  id               INT AUTO_INCREMENT PRIMARY KEY,
  patient_id       INT NOT NULL,
  doctor_id        INT NOT NULL,
  booking_id       INT,
  visit_date       DATE NOT NULL,
  diagnosis        TEXT,
  symptoms         TEXT,
  next_appointment DATETIME,
  FOREIGN KEY (patient_id) REFERENCES patients(id),
  FOREIGN KEY (doctor_id)  REFERENCES doctors(id),
  FOREIGN KEY (booking_id) REFERENCES bookings(id)
);

-- ตารางใบสั่งยา
CREATE TABLE prescriptions (
  id                  INT AUTO_INCREMENT PRIMARY KEY,
  medical_history_id  INT NOT NULL,
  medicine_name       VARCHAR(200),
  dosage              VARCHAR(200),
  FOREIGN KEY (medical_history_id) REFERENCES medical_history(id)
);

-- ตารางการแจ้งเตือน
CREATE TABLE notifications (
  id          INT AUTO_INCREMENT PRIMARY KEY,
  patient_id  INT NOT NULL,
  type        VARCHAR(50),
  title       VARCHAR(200),
  message     TEXT,
  is_read     TINYINT(1) DEFAULT 0,
  created_at  DATETIME DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (patient_id) REFERENCES patients(id)
);
```

